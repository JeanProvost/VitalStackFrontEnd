# Base URL of the VitalStack .NET API (no trailing slash).
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
EXPO_PUBLIC_API_URL=http://localhost:5000

# AWS Cognito user pool (from the API's Cognito configuration).
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
EXPO_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
